# =============================================================================
# SimchaSync — environment variable reference (placeholders only, NO secrets)
# =============================================================================
# Copy to `.env.local` for local dev and fill in real values.
# Client vars (VITE_*) are embedded in the browser bundle at build time, so they
# must be PUBLIC-safe only. Server secrets below are configured in Supabase
# (`supabase secrets set NAME=value`) and in your Stripe/Vercel dashboards — they
# are listed here for documentation and must never be placed in a VITE_ var.

# -----------------------------------------------------------------------------
# Frontend (Vite) — safe to expose in the browser
# -----------------------------------------------------------------------------
# Supabase project URL and browser publishable key.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXXXXXX
# Legacy anon key — only needed for older environments; leave unset on new setups.
# (If it is a legacy eyJ… JWT it is ignored by src/integrations/supabase/client.ts.)
VITE_SUPABASE_ANON_KEY=

# Canonical app origin, used for auth redirect links (e.g. https://pro.simchasync.com).
VITE_APP_URL=https://pro.simchasync.com
# Origin that serves public tenant booking pages (/book/:slug), e.g. https://www.simchasync.com.
VITE_PUBLIC_BOOKING_ORIGIN=https://www.simchasync.com

# Maintenance kill switch. Set to "true" to show the Maintenance page for all users.
VITE_APP_KILL_SWITCH=false
VITE_APP_KILL_SWITCH_MESSAGE=

# =============================================================================
# Supabase Edge Function secrets (set via `supabase secrets set`, NOT in the bundle)
# =============================================================================
# --- Supabase service access ---
# SUPABASE_URL                     # project URL (auto-provided in the Supabase runtime)
# SUPABASE_ANON_KEY                # anon key (auto-provided)
# APP_SECRET_API_KEY               # SERVICE ROLE key — full DB access. Keep secret.
# APP_PUBLISHABLE_KEY              # publishable key used by some functions
# APP_URL / ROOT_DOMAIN            # canonical origins for CORS + links

# --- Stripe (billing) ---
# STRIPE_SECRET_KEY
# STRIPE_WEBHOOK_SECRET
# STRIPE_CONNECT_WEBHOOK_SECRET

# --- Email (Resend + SMTP) ---
# RESEND_API_KEY / RESEND_FROM / FROM_DOMAIN / SENDER_DOMAIN / SITE_NAME
# SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASS
# SEND_EMAIL_HOOK_SECRET           # verifies Supabase auth email webhook
# ADMIN_EMAIL                      # notification recipient

# --- SMS (Twilio) ---
# TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN / TWILIO_FROM_NUMBER

# --- Google Calendar OAuth ---
# GOOGLE_OAUTH_CLIENT_ID / GOOGLE_OAUTH_CLIENT_SECRET
# GCAL_REDIRECT_URI / GCAL_STATE_SECRET

# --- AI (captions / chat) ---
# AI_API_KEY / AI_BASE_URL / AI_MODEL
# GEMINI_API_KEY / GEMINI_MODEL

# --- Scheduled job shared secrets (protect cron-triggered functions) ---
# COLLEAGUE_REMINDER_SECRET / INQUIRY_REMINDER_SECRET / WORK_REPORT_SECRET
# WORK_REPORT_EMAIL

# --- Misc ---
# WORKSPACE_LIMITS_CONFIG          # JSON config for per-plan workspace limits
